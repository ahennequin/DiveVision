# Copy to .env (git-ignored) for `npm run web`. Every EXPO_PUBLIC_* value is
# compiled into the app bundle and is therefore public.

# This app's Supabase project (the same one as the backend's SUPABASE_URL).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key - the backend's SUPABASE_KEY. NEVER the secret /
# service-role key (SUPABASE_SERVICE_ROLE_KEY): it bypasses RLS, and the app
# refuses to start with one.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# The FastAPI backend. Its CORS_ALLOWED_ORIGINS must include this app's origin
# (http://localhost:8081 for both `npm run web` and the compose `client`).
EXPO_PUBLIC_API_URL=http://localhost:8000
