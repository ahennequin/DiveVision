# MLFlow
MLFLOW_HOST=...
MLFLOW_PORT=...
MLFLOW_ARTIFACT_UPLOAD_DOWNLOAD_TIMEOUT=10

# Supabase (managed Postgres backing MLflow; docker-compose.yml's local postgres-dev
# service is a dev/test stand-in and overrides SUPABASE_POSTGRES_HOST for the mlflow container)
SUPABASE_POSTGRES_USER=...
SUPABASE_POSTGRES_PASSWORD=...
SUPABASE_POSTGRES_DB=...
SUPABASE_POSTGRES_HOST=...
SUPABASE_POSTGRES_PORT=...

# Supabase (this app's own project - auth, photo storage, the photos and
# leaderboard tables; see supabase/. Deliberately a separate project from
# the one above, so app data and MLflow's tracking data never share an API
# surface). Used by divevision/src/app/supabase_api.py.
SUPABASE_URL=...
SUPABASE_KEY=...
# Service-role key: backend containers only (api + worker), never sent to
# any client. Clients can only read their own photos, so every write goes
# through it: the api's uploads/deletions on behalf of a verified user, the
# worker's enhancement results (jobs outlive user tokens), account deletion,
# and leaderboard rows.
SUPABASE_SERVICE_ROLE_KEY=...

# Redis backing the arq job queue between the api and the worker.
# docker-compose.yml overrides this to its `redis` service for both.
REDIS_URL=redis://localhost:6379

# Comma-separated browser origins allowed to call the api (CORS), i.e. the
# Expo web client. 8081 is the Expo dev server's default port.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Shared secret the POST /leaderboard endpoint checks (X-Leaderboard-Secret
# header) - a local MLflow benchmark run authenticates with this, not a
# Supabase key of any kind.
LEADERBOARD_SHARED_SECRET=...

# S3
AWS_DEFAULT_REGION=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_ENDPOINT_URL=...